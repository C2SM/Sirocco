! Dates, restart/checkpoint intervals, restart flags and model ranks are set by Sirocco
&master_nml
 lrestart               = .false.
 read_restart_namelists = .false.
/
&master_time_control_nml
 calendar             = 'proleptic gregorian'
 experimentStartDate  = '2020-01-01T00:00:00Z'
 experimentStopDate   = '2020-06-01T00:00:00Z'
 restartTimeIntval    = 'P1M'
 checkpointTimeIntval = 'P1M'
/
&time_nml
 is_relative_time     = .true.
/
&master_model_nml
  model_name="atmo"
  model_namelist_filename="NAMELIST_atm"
  model_type=1
  model_min_rank=0
  model_max_rank=0
  model_inc_rank=1
/
&master_model_nml
  model_name="ocean"
  model_namelist_filename="NAMELIST_oce"
  model_type=2
  model_min_rank=0
  model_max_rank=0
  model_inc_rank=1
/
&jsb_control_nml
 is_standalone      = .false.
 restart_jsbach     = .false.
 debug_level        = 0
 timer_level        = 0
/
&jsb_model_nml
 model_id = 1
 model_name = "JSBACH"
 model_shortname = "jsb"
 model_description = 'JSBACH land surface model'
 model_namelist_filename = "NAMELIST_lnd"
/
